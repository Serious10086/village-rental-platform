# ============================================================================
#  部署环境变量模板
#
#  用法:
#      cd docker
#      cp .env.example .env      # 然后按下面的说明填
#      docker compose up -d --build
#
#  【.env 不要提交】
#  它里面有数据库密码和 AI 密钥。根目录 .gitignore 已经挡了 docker/.env,
#  仓库里只留这份模板。
# ============================================================================

# ── 数据库 ──────────────────────────────────────────────────
# MySQL root 密码。首次启动时用它初始化数据库;之后改这里不会改掉
# 已有的密码(密码存在数据卷里),要改得进容器执行 ALTER USER,
# 或者删掉数据卷重新初始化(会丢数据)。
#
# 默认值 root 只为让"什么都不填也能起来"成立。真要放到公网,
# 第一件事是把它换掉 —— 这台 MySQL 的 root 账号是能被远程连的。
DB_ROOT_PASSWORD=root

# ── 对外端口 ────────────────────────────────────────────────
# 前端(Nginx)在宿主机上暴露的端口。浏览器访问 http://localhost:8080
# 之类;默认 80 直接访问 http://localhost。
#
# 【为什么默认是 8088 而不是 80】
# 本机 80 端口经常被别的东西占着(比如 IIS、其他 web 服务),而
# "port is already allocated" 这个报错不会告诉你占用者是谁。
# 8088 基本不会撞上,想用 80 的话把它改成 80 即可。
WEB_PORT=8088

# ── AI 智能客服(批次 7)─────────────────────────────────────
# DeepSeek 密钥,从 https://platform.deepseek.com 申请(需充值)。
#
# 不填也能启动:所有问答会走"本地问答库 → 通用话术"这两级降级,
# 平台上其他地方一切正常。答辩时想演示 AI 就必须填。
#
# 格式形如 sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# ── JWT 签名密钥 ────────────────────────────────────────────
# 必须填,否则 docker compose 会直接报错退出(容器起不来)。
#
# 为什么必须:签发和校验登录 token 全靠它。镜像里没有 application-dev.yml
# (那个文件含本机密钥,构建时删掉了),所以只能从环境变量注入。
#
# HS256 要求至少 32 字节,生成一个:
#     openssl rand -base64 48
#
# 【不要提交这一行】docker/.env 已被 .gitignore 挡住,改完确认一下。
JWT_SECRET=

# ── 数据库表名(一般不用改)─────────────────────────────────
MYSQL_DATABASE=village_rental
