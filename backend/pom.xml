<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot 3.5.16 说明:
        原计划用 3.2,但 3.2.x 已于 2024-12-31 停止开源维护(末版 3.2.12),
        用停止维护的版本答辩时会被追问。3.5.16 是当前 3.5 分支最新版,
        同为 3.x / jakarta 命名空间,代码写法与 3.2 零差异。

        为什么不直接用最新的 4.1.1:Spring Security 7、Spring Framework 7
        等有较多破坏性变更,中文资料少,毕设工期下不划算。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.gjf</groupId>
    <artifactId>village-rental-platform</artifactId>
    <version>1.0.0</version>
    <name>village-rental-platform</name>
    <description>乡村闲置资源租售平台 - 后端服务</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- MyBatis-Plus 与 jsqlparser 版本必须一致 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <jjwt.version>0.12.7</jjwt.version>
    </properties>

    <dependencies>
        <!-- ── Web ────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验 @NotNull / @Valid -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP:按钮级权限校验、操作日志切面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ── 数据层 ──────────────────────────────────────────── -->
        <!--
          注意:Spring Boot 3 必须用 mybatis-plus-spring-boot3-starter,
          用错成 mybatis-plus-boot-starter 会在启动时抛 NoClassDefFoundError
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!--
          MyBatis-Plus 自 3.5.9 起把 jsqlparser 拆成独立依赖,
          分页插件 PaginationInnerInterceptor 依赖它。
          不加这个依赖,分页会抛 ClassNotFoundException。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动,版本由 Spring Boot BOM 托管,不要手写版本号 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ── 认证 ────────────────────────────────────────────── -->
        <!--
          jjwt 0.12.7,不是实训项目用的 0.9.1。
          0.9.1 依赖 javax.xml.bind,该模块在 Java 9+ 已被移除,
          在 Java 17 下必须手动补 jaxb-api 才能用 —— 那是 Java 8 时代的写法。
          0.12.x 的 API 也变了:
            构建:Jwts.builder().signWith(SecretKey)
            解析:Jwts.parser().verifyWith(key).build().parseSignedClaims(token)
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 密码加密 BCryptPasswordEncoder(spring-security-crypto 单模块,
             不引入完整的 Spring Security) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ── 工具 ────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          springdoc-openapi:自动生成 RESTful 接口文档,访问 /swagger-ui.html

          版本选择注意:springdoc 3.x 是给 Spring Boot 4 的
          (它依赖的 artifact 名已改成 Boot 4 的模块划分),
          Spring Boot 3.x 必须用 2.x 线。这里用 2.9.1(2.x 最新)。

          没有用 knife4j:它自己又包了一层 springdoc,多一层版本兼容风险,
          而 springdoc 自带的 Swagger UI 对毕设演示已经够用。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.9.1</version>
        </dependency>

        <!-- ── 测试 ────────────────────────────────────────────── -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                    <!--
                      强制 UTF-8,否则中文日志是乱码。

                      【为什么 mvn.sh 里的 MAVEN_OPTS 不够】
                      MAVEN_OPTS 只作用于 Maven 自己那个 JVM。spring-boot:run
                      会**另起一个 fork 的 JVM** 跑应用,那个 JVM 的控制台编码
                      跟的是 Windows 的 ANSI 代码页(本机是 GBK),和 Maven
                      的编码没有关系。表现是:控制台里中文看着还行,
                      但一旦重定向到文件(或者被 grep),中文就是乱码 ——
                      连 grep "AI 智能客服" 都匹配不上,因为它按字节比。

                      三个都要设:file.encoding 管默认字符集,
                      sun.stdout/stderr.encoding 管两个输出流的编码
                      (Java 17 认这两个名字)。
                    -->
                    <jvmArguments>-Dfile.encoding=UTF-8 -Dsun.stdout.encoding=UTF-8 -Dsun.stderr.encoding=UTF-8</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
